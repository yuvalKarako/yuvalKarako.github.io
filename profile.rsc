11:["$","section",null,{"id":"selected-work","children":[["$","h2",null,{"children":"Selected work"}],[["$","article","ecological-intelligence",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/work/ecological-intelligence","children":["Ecological intelligence",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"Developing AI workflows that connect computer vision, ecological measurement, and scientific literature — to help interpret change in marine ecosystems."}]]}],["$","article","institutional-systems",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/work/institutional-systems","children":["Institutional R&D",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"Leading R&D and product work in the public-security sector. Connecting the problem, the architecture, and the people needed to turn an idea into an operational system."}]]}],["$","article","high-ai",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/work/high-ai","children":["Teaching agentic AI",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"Teaching researchers and senior academics to build personal knowledge bases and put agentic AI to work — connecting deep domain expertise with new ways of thinking and building."}]]}],["$","article","marine-ai-review",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/work/marine-ai-review","children":["AI for marine monitoring",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"Examining how AI is used in marine ecological monitoring, and the gap between visual detection and ecological interpretation."}]]}],["$","article","knowledge-infrastructure",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/work/knowledge-infrastructure","children":["Human–AI knowledge systems",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"Developing ways to turn notes, sources, and experience into a connected knowledge base that people and AI agents can work with together."}]]}]]]}]
12:["$","section",null,{"id":"hebrew","lang":"he","dir":"rtl","children":[["$","h2",null,{"children":"יובל קרקו"}],["$","p",null,{"children":"יובל קרקו הוא חוקר לתואר שני בביוטכנולוגיה באוניברסיטת בר־אילן, הפועל במפגש שבין בינה מלאכותית לאקולוגיה ימית. מחקרו עוסק בפיתוח תהליכי עבודה המשלבים מידע חזותי וידע מדעי כדי לסייע בהבנת שינויים במערכות אקולוגיות. לצד המחקר הוא מוביל מו״פ ועבודת מוצר במגזר ביטחון הציבור, ומלמד בתוכנית HIGH AI על תהליכי עבודה סוכניים, מוחות שניים ובסיסי ידע אישיים."}]]}]
