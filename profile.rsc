3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Professional profile — Yuval Karako"}],["$","meta","1",{"name":"description","content":"Yuval Karako is an M.Sc. researcher in Biotechnology at Bar-Ilan University, working at the intersection of artificial intelligence and marine ecology. He develops AI workflows that connect visual observation with scientific evidence to support the interpretation of ecological change. He also leads R&D and product work in the public-security sector and teaches in HIGH AI, focusing on agentic workflows, Second Brains, and personal knowledge bases."}],["$","meta","2",{"property":"og:title","content":"Yuval Karako — Professional profile"}],["$","meta","3",{"property":"og:description","content":"Yuval Karako is an M.Sc. researcher in Biotechnology at Bar-Ilan University, working at the intersection of artificial intelligence and marine ecology. He develops AI workflows that connect visual observation with scientific evidence to support the interpretation of ecological change. He also leads R&D and product work in the public-security sector and teaches in HIGH AI, focusing on agentic workflows, Second Brains, and personal knowledge bases."}],["$","meta","4",{"property":"og:type","content":"profile"}],["$","meta","5",{"name":"twitter:card","content":"summary"}],["$","meta","6",{"name":"twitter:title","content":"Yuval Karako — AI, Research & Systems"}],["$","meta","7",{"name":"twitter:description","content":"Yuval Karako is a researcher and builder working across artificial intelligence, marine ecology, institutional R&D, and human–AI knowledge systems."}],["$","link","8",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","9",{"rel":"canonical","href":"https://yuvalkarako.github.io/profile"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initia