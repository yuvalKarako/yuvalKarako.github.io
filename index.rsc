e:T610,{"@context":"https://schema.org","@type":"ProfilePage","url":"https://yuvalkarako.github.io/","dateModified":"2026-10-06","mainEntity":{"@context":"https://schema.org","@type":"Person","@id":"https://yuvalkarako.github.io/#person","name":"Yuval Karako","alternateName":"יובל קרקו","url":"https://yuvalkarako.github.io/","image":"https://yuvalkarako.github.io/media/portrait.webp","description":"Yuval Karako is a graduate researcher in AI & Biotechnology (M.Sc.) at Bar-Ilan University's Marine Ecosystem Dynamics Lab, where he leads an AI research project that moves from detecting ecological change to explaining its causes. He is the AI research lead on a 2026 BIU AI Convergence seed grant with Prof. Carmit Altman and Dr. Gal Eyal. He teaches agentic AI and personal knowledge bases to senior faculty in HIGH AI, Bar-Ilan's flagship AI program for academics, and leads digital transformation in the IDF Education & Youth Corps.","jobTitle":["Graduate Researcher in AI & Biotechnology, Bar-Ilan University","Head of Digital Transformation, IDF Education & Youth Corps","Teaching Faculty, HIGH AI"],"award":["BIU AI Convergence seed grant, 2026"],"affiliation":{"@type":"CollegeOrUniversity","name":"Bar-Ilan University","url":"https://www.biu.ac.il/en"},"sameAs":["https://www.linkedin.com/in/yuvalkarako/","https://github.com/yuvalKarako"],"knowsAbout":["Causal reasoning with AI","Retrieval-augmented generation","Computer vision for underwater imagery","Marine ecology","Agentic AI adoption","LLM knowledge bases","Product management"]}}1:["$","main",null,{"id":"main","className":"wrap inner-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$e"}}],["$","div",null,{"className":"page-heading profile-heading","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"THE PROFESSIONAL PROFILE"}],["$","h1",null,{"children":["Yuval Karako",["$","span",null,{"className":"brand-dot","children":"."}]]}]