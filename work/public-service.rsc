1:["$","main",null,{"id":"main","className":"wrap inner-page","children":[["$","div",null,{"className":"page-heading","children":[["$","a",null,{"className":"eyebrow","href":"/work","children":["← ALL WORK / ","PUBLIC SERVICE"]}],["$","h1",null,{"children":["Digital transformation in the IDF",["$","span",null,{"className":"brand-dot","children":"."}]]}],["$","p",null,{"children":"New technology, within the budget that already exists."}]]}],"$undefined",["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-side","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"CONTEXT"}],["$","p",null,{"children":"Head of Digital Transformation · IDF Education & Youth Corps"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"STATUS"}],["$","p",null,{"children":"CURRENT ROLE"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"HOW IT CONNECTS"}],["$","a",null,{"className":"text-link","href":"/map","children":["View the map",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}],["$","article",null,{"className":"article-body","children":[[["$","section","The role",{"children":[["$","h2",null,{"children":"The role"}],["$","p",null,{"children":"The Corps works with a small digital team and little technical infrastructure. My job is to bring current technology, AI included, to problems that would otherwise need more people or more money: defining the product, writing the specification, and showing commanders a working demonstration they can judge for themselves."}]]}],["$","section","What it takes",{"children":[["$","h2",null,{"children":"What it takes"}],["$","p",null,{"children":"A system gets used only when the people who define the need, the people who build it and the people who will use it agree on what it is for. Much of my work is translation between those three groups."}]]}],["$","section","Before this",{"children":[["$","h2",null,{"children":"Before this"}],["$","p",null,{"children":"During my regular service I was a product manager in the IDF (2020–22): mapping how a large organization actually works, defining the product, and presenting roadmaps and MVPs to decision-makers. That is where I learned how large organizations adopt technology. Before the army, I co-founded a small studio that published two mobile games."}]]}]],false,["$","a",null,{"className":"text-link","href":"/work/public-service/text","style":{"display":"flex","width":"fit-content","marginTop":20},"children":["Read as Markdown",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M6 18 18 6M6 6h12v12","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}],["$","section",null,{"className":"article-related","children":[["$","p",null,{"className":"eyebrow","children":"THE OTHER TWO ROLES"}],["$","div",null,{"children":[["$","a","research",{"className":"text-link","href":"/work/research","children":["Research",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","a","teaching",{"className":"text-link","href":"/work/teaching","children":["Teaching agentic AI",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"roun