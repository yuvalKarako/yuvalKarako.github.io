3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Digital transformation in the IDF — Yuval Karako"}],["$","meta","1",{"name":"description","content":"I head digital transformation in the IDF Education & Youth Corps. I find problems the Corps already has that technology can solve, define the product, and take it to a working demonstration, without adding budget or headcount."}],["$","meta","2",{"property":"og:title","content":"Digital transformation in the IDF — Yuval Karako"}],["$","meta","3",{"property":"og:description","content":"I head digital transformation in the IDF Education & Youth Corps. I find problems the Corps already has that technology can solve, define the product, and take it to a working demonstration, without adding budget or headcount."}],["$","meta","4",{"property":"og:url","content":"https://yuvalkarako.github.io/work/public-service"}],["$","meta","5",{"name":"twitter:card","content":"summary"}],["$","meta","6",{"name":"twitter:title","content":"Yuval Karako — Graduate Researcher in AI & Biotechnology, Bar-Ilan University"}],["$","meta","7",{"name":"twitter:description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology at Bar-Ilan University, leading an AI research project on automated monitoring of marine ecosystems. He designs and teaches agentic-AI practice for Bar-Ilan's senior academic leadership, and heads digital transformation in the IDF Education & Youth Corps."}],["$","link","8",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","9",{"rel":"canonical","href":"https://yuvalkarako.github.io/work/public-service"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"ch