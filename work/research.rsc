14:["$","section",null,{"className":"article-related","children":[["$","p",null,{"className":"eyebrow","children":"THE OTHER TWO ROLES"}],["$","div",null,{"children":[["$","a","teaching",{"className":"text-link","href":"/work/teaching","children":["Teaching agentic AI",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","a","public-service",{"className":"text-link","href":"/work/public-service","children":["Digital transformation in the IDF",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}]
15:["$","section","How success is measured",{"children":[["$","h3",null,{"children":"How success is measured"}],["$","p",null,{"children":"The thresholds are fixed before any model is trained. On children’s narratives, the model’s coherence ratings must agree with expert raters at least as well as the raters agree with each other, and it must recover the story’s structure and causal links against expert coding. On reefs, experts check whether it identifies the intended species, condition or stressor, and whether its confidence is calibrated. The end-to-end test: a non-expert description and a photo produce ranked, evidence-backed causes that the lab’s experts accept as plausible."}]]}]
16:["$","section","Where it stands",{"children":[["$","h3",null,{"children":"Where it stands"}],["$","p",null,{"children":"The grant was awarded in August 2026 for a twelve-month proof of concept, and the research work began in October 2026. First results are planned for early 2027."}]]}]
17:["$","section","Why it matters",{"children":[["$","h3",null,{"children":"Why it matters"}],["$","p",null,{"children":"For child-language research and practice, an objective, AI-assisted measure of narrative coherence would ease a long-standing manual-coding bottleneck. For ecology, it opens a low-cost monitoring channel from divers, fishers and citizen scientists. Longer term, the same layer could turn any under-specified human input into a clear, structured request."}]]}]
