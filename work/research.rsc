1:["$","main",null,{"id":"main","className":"wrap inner-page","children":[["$","div",null,{"className":"page-heading","children":[["$","a",null,{"className":"eyebrow","href":"/work","children":["← ALL WORK / ","RESEARCH"]}],["$","h1",null,{"children":["Research",["$","span",null,{"className":"brand-dot","children":"."}]]}],["$","p",null,{"children":"AI that explains why a reef is changing."}]]}],"$undefined",["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-side","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"CONTEXT"}],["$","p",null,{"children":"M.Sc. Biotechnology · Marine Ecosystem Dynamics Lab (Dr. Gal Eyal) · Bar-Ilan University"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"STATUS"}],["$","p",null,{"children":"FIVE RESEARCH LINES · THESIS IN EVALUATION"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"HOW IT CONNECTS"}],["$","a",null,{"className":"text-link","href":"/map","children":["View the map",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}],["$","article",null,{"className":"article-body","children":[[["$","p",null,{"className":"research-intro","children":"Five lines of research, one question: how AI can move from describing what is there to explaining why it happened. Select one to read it in full."}],"$undefined",[["$","ol",null,{"className":"research-list","children":[["$","li","etiology-system",{"id":"etiology-system","children":["$","details",null,{"className":"research-item","children":[["$","summary",null,{"children":[["$","span",null,{"className":"r-index mono","children":"01"}],["$","span",null,{"className":"r-head","children":[["$","span",null,{"className":"r-kind mono","children":"M.SC. THESIS"}],["$","span",null,{"className":"r-title","children":"From detection to diagnosis: AI for coral reef decline"}],["$","span",null,{"className":"r-summary","children":"An AI system that measures every coral in underwater images, follows each colony over time, and proposes likely causes when it finds damage."}]]}],["$","span",null,{"className":"r-side","children":[["$","span",null,{"className":"r-status mono","children":"WORKING PROTOTYPE · EVALUATION UNDER WAY"}],["$","span",null,{"className":"r-toggle","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"r-body","children":[["$","dl",null,{"className":"r-facts","children":[["$","div","Lab",{"children":[["$","dt",null,{"className":"mono","children":"Lab"}],["$","dd",null,{"children":["Marine Ecosystem Dynamics Lab, Bar-Ilan University","$undefined"]}]]}],["$","div","Advisor",{"children":[["$","dt",null,{"className":"mono","children":"Advisor"}],["$","dd",null,{"children":["Dr. Gal Eyal","$undefined"]}]]}],["$","div","Case study",{"children":[["$","dt",null,{"className":"mono","children":"Case study"}],["$","dd",null,{"children":["Coral reef degradation in the Gulf of Eilat","$undefined"]}]]}]]}],[["$","section","The problem",{"children":[["$","h3",null,{"children":"The problem"}],["$","p",null,{"children":"Coral reefs are monitored mostly by photographing them and labeling what is in the photos by hand. That is slow, and it only answers what is there. The people responsible for a reef also need to know why it is degrading, and they need to know early."}]]}],["$","section","What I built",{"children":[["$","h3",null,{"children":"What I built"}],["$","p",null,{"children":"A system in three layers. Perception: measure every organism in an image, calibrated to real surface area. Demography: identify each colony and follow it from one survey to the next. Etiology: an AI agent that proposes likely causes for the damage it sees, citing the literature it relies on, a corpus of 845 papers and 8,359 indexed passages."}]]}],["$","section","What is not proven yet",{"children":[["$","h3",null,{"children":"What is not proven yet"}],["$","p",null,{"children":"The first two layers work as a proof of concept. The third shows that the architecture is feasible, but its accuracy has not been measured yet; that evaluation is the next year of the thesis. A plausible explanation is not necessarily a correct one, so the rate at which the agent invents causes will be reported as a primary metric."}]]}]],"$undefined"]}]]}]}],"$Ld","$Le","$Lf","$L10"]}],"$L11"]],"$L12","$L13"]}]]}],"$L14"]}]
