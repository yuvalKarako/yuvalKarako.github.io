3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Research — Yuval Karako"}],["$","meta","1",{"name":"description","content":"My M.Sc. thesis builds an AI system that goes past labeling underwater images. It measures each coral, follows it over time, and when it finds damage, proposes likely causes based on 845 scientific papers. Most existing tools stop at the labeling step. Around it: a BIU AI Convergence grant with Prof. Carmit Altman, a systematic review, and a collaboration with the Technion."}],["$","meta","2",{"property":"og:title","content":"Research — Yuval Karako"}],["$","meta","3",{"property":"og:description","content":"My M.Sc. thesis builds an AI system that goes past labeling underwater images. It measures each coral, follows it over time, and when it finds damage, proposes likely causes based on 845 scientific papers. Most existing tools stop at the labeling step. Around it: a BIU AI Convergence grant with Prof. Carmit Altman, a systematic review, and a collaboration with the Technion."}],["$","meta","4",{"property":"og:url","content":"https://yuvalkarako.github.io/work/research"}],["$","meta","5",{"name":"twitter:card","content":"summary"}],["$","meta","6",{"name":"twitter:title","content":"Yuval Karako — Graduate Researcher in AI & Biotechnology, Bar-Ilan University"}],["$","meta","7",{"name":"twitter:description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology at Bar-Ilan University, leading an AI research project on automated monitoring of marine ecosystems. He designs and teaches agentic-AI practice for Bar-Ilan's senior academic leadership, and heads digital transformation in the IDF Education & Youth Corps."}],["$","link","8",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","9",{"rel":"canonical","href":"https://yuvalkarako.github.io/work/research"