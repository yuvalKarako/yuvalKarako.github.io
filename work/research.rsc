d:["$","li","coherence-to-meaning",{"id":"coherence-to-meaning","children":["$","details",null,{"className":"research-item","children":[["$","summary",null,{"children":[["$","span",null,{"className":"r-index mono","children":"02"}],["$","span",null,{"className":"r-head","children":[["$","span",null,{"className":"r-kind mono","children":"BIU AI CONVERGENCE SEED GRANT · 2026–27"}],["$","span",null,{"className":"r-title","children":"Coherence to meaning: recovering structured meaning from imprecise descriptions"}],["$","span",null,{"className":"r-summary","children":"People describe what they see in imprecise words. This project teaches a model to recover the structure behind those words, first in children’s narratives, then in divers’ reports of reef damage."}]]}],["$","span",null,{"className":"r-side","children":[["$","span",null,{"className":"r-status mono","children":"AWARDED · WORK BEGAN OCTOBER 2026"}],["$","span",null,{"className":"r-toggle","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"r-body","children":[["$","dl",null,{"className":"r-facts","children":[["$","div","Principal investigators",{"children":[["$","dt",null,{"className":"mono","children":"Principal investigators"}],["$","dd",null,{"children":["Prof. Carmit Altman (Child Language and Narrative Lab, Faculty of Education) and Dr. Gal Eyal (Marine Ecosystem Dynamics Lab, Faculty of Life Sciences)","$undefined"]}]]}],["$","div","My role",{"children":[["$","dt",null,{"className":"mono","children":"My role"}],["$","dd",null,{"children":["AI research lead: I design and build the model and connect it to the reef diagnosis system","$undefined"]}]]}],["$","div","Partners",{"children":[["$","dt",null,{"className":"mono","children":"Partners"}],["$","dd",null,{"children":["Bar-Ilan Data Science and AI Institute (DSAI), methodological and engineering partner","$undefined"]}]]}]]}],[["$","section","The idea",{"children":[["$","h3",null,{"children":"The idea"}],["$","p",null,{"children":"Two labs that look unrelated face the same problem from opposite ends. Prof. Altman’s lab has spent two decades studying how children build coherent stories: who is involved, what happened, and why. Reef monitoring increasingly depends on non-expert observers such as divers and citizen scientists, whose reports are just as imprecise. In both cases the scientific value lies in the structure behind the words, and neither field has a model that can recover it."}]]}],["$","section","The data",{"children":[["$","h3",null,{"children":"The data"}],["$","p",null,{"children":"Children’s narratives from the Altman lab, collected with standardized picture-based instruments (MAIN) from monolingual and bilingual children, with and without language impairment, and rated for coherence by trained experts. On the reef side: coral imagery and expert-labelled descriptions written in a non-expert style, from the Eyal lab."}]]}],["$","section","The model",{"children":[["$","h3",null,{"children":"The model"}],["$","p",null,{"children":"An open language model, fine-tuned with parameter-efficient methods (LoRA) on the expert-coded narratives. It maps a narrative onto a typed structure: referents, events, causal relations and internal states. Two outputs share that representation: a predicted coherence rating, and a repaired, structured version of the story with a confidence estimate. It is benchmarked against an off-the-shelf language model and a classical coding pipeline, so the value of the fine-tuning can be measured."}]]}],["$","section","From stories to reefs",{"children":[["$","h3",null,{"children":"From stories to reefs"}],["$","p",null,{"children":"Today the diagnosis system needs a structured description of the damage, such as “tissue loss, apical, Porites”. After the transfer, a diver can write “a big round coral, the top is white and looks peeled”, and the model turns it into the structured fields — coral type, damage type, location and severity — each with its own confidence, which then feed the diagnosis."}]]}],"$L15","$L16","$L17"],"$undefined"]}]]}]}]
e:["$","li","systematic-review",{"id":"systematic-review","children":["$","details",null,{"className":"research-item","children":[["$","summary",null,{"children":[["$","span",null,{"className":"r-index mono","children":"03"}],["$","span",null,{"className":"r-head","children":[["$","span",null,{"className":"r-kind mono","children":"SYSTEMATIC REVIEW"}],["$","span",null,{"className":"r-title","children":"From perception to causation: AI for marine ecological monitoring"}],["$","span",null,{"className":"r-summary","children":"A PRISMA 2020 systematic review mapping what AI for marine monitoring can do today, and where it stops short of ecological explanation."}]]}],["$","span",null,{"className":"r-side","children":[["$","span",null,{"className":"r-status mono","children":"SCREENING"}],["$","span",null,{"className":"r-toggle","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"r-body","children":[["$","dl",null,{"className":"r-facts","children":[["$","div","Method",{"children":[["$","dt",null,{"className":"mono","children":"Method"}],["$","dd",null,{"children":["PRISMA 2020 systematic review","$undefined"]}]]}]]}],[["$","section","The question",{"children":[["$","h3",null,{"children":"The question"}],["$","p",null,{"children":"A useful synthesis must distinguish the task a model performs from the ecological conclusions its outputs can support. Detection, measurement, interpretation and causal explanation ask different things of a system, and the literature often blurs them."}]]}],["$","section","Why it comes first",{"children":[["$","h3",null,{"children":"Why it comes first"}],["$","p",null,{"children":"The map of what the field cannot yet do frames the research questions and the evaluation criteria for the thesis."}]]}]],"$undefined"]}]]}]}]
f:["$","li","settlement-plates",{"id":"settlement-plates","children":["$","details",null,{"className":"research-item","children":[["$","summary",null,{"children":[["$","span",null,{"className":"r-index mono","children":"04"}],["$","span",null,{"className":"r-head","children":[["$","span",null,{"className":"r-kind mono","children":"COLLABORATION · TECHNION"}],["$","span",null,{"className":"r-title","children":"Image analysis of reef settlement plates"}],["$","span",null,{"className":"r-summary","children":"Segmentation, annotation and color analysis of ceramic plates with different roughness and porosity, photographed over time, to follow how reef communities settle on them."}]]}],["$","span",null,{"className":"r-side","children":[["$","span",null,{"className":"r-status mono","children":"IN PROGRESS"}],["$","span",null,{"className":"r-toggle","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"r-body","children":[["$","dl",null,{"className":"r-facts","children":[["$","div","With",{"children":[["$","dt",null,{"className":"mono","children":"With"}],["$","dd",null,{"children":["A research group at the Technion","$undefined"]}]]}]]}],[["$","section","My part",{"children":[["$","h3",null,{"children":"My part"}],["$","p",null,{"children":"Building the segmentation and annotation workflow for the plate images and an interactive dashboard for the analysis."}]]}],["$","section","A methodological lesson",{"children":[["$","h3",null,{"children":"A methodological lesson"}],["$","p",null,{"children":"The plates were photographed across many separate sessions, so lighting and camera differences can look like biology. Part of the work is harmonizing exposure and color without discarding or masking any image, and recording exactly what was applied to each one."}]]}]],"$undefined"]}]]}]}]
10:["$","li","methods-paper",{"id":"methods-paper","children":["$","details",null,{"className":"research-item","children":[["$","summary",null,{"children":[["$","span",null,{"className":"r-index mono","children":"05"}],["$","span",null,{"className":"r-head","children":[["$","span",null,{"className":"r-kind mono","children":"METHODS PAPER"}],["$","span",null,{"className":"r-title","children":"Research with AI over an indexed knowledge base"}],["$","span",null,{"className":"r-summary","children":"A methods paper on doing research with AI on top of an indexed, version-controlled knowledge base: the workflow I use in my own research and teach in HIGH AI."}]]}],["$","span",null,{"className":"r-side","children":[["$","span",null,{"className":"r-status mono","children":"IN PREPARATION"}],["$","span",null,{"className":"r-toggle","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"r-body","children":[["$","dl",null,{"className":"r-facts","children":[["$","div","Tools",{"children":[["$","dt",null,{"className":"mono","children":"Tools"}],["$","dd",null,{"children":["Obsidian, Git, Claude","$undefined"]}]]}]]}],[["$","section","What it documents",{"children":[["$","h3",null,{"children":"What it documents"}],["$","p",null,{"children":"How notes, sources and drafts are organized so that AI can work with them, and where AI-assisted writing breaks: for example, a citation that looks right but says something the source does not. The paper documents the checks that catch these errors, and measures how often the checks themselves are wrong."}]]}]],[["$","a","/work/teaching",{"className":"text-link","href":"/work/teaching","children":["How I teach it",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]]}]]}]}]
