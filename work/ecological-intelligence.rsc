1:["$","main",null,{"id":"main","className":"wrap inner-page","children":[["$","div",null,{"className":"page-heading","children":[["$","a",null,{"className":"eyebrow","href":"/work","children":["← ALL WORK / ","RESEARCH"]}],["$","h1",null,{"children":["Ecological intelligence",["$","span",null,{"className":"brand-dot","children":"."}]]}],["$","p",null,{"children":"From observation toward explanation."}]]}],["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-side","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"CONTEXT"}],["$","p",null,{"children":"M.Sc. research · Biotechnology · Bar-Ilan University"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"STATUS"}],["$","p",null,{"children":"ACTIVE RESEARCH"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"AT THE INTERSECTION"}],["$","a",null,{"className":"text-link","href":"/map","children":["View the map",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}],["$","article",null,{"className":"article-body","children":[[["$","section","The question",{"children":[["$","h2",null,{"children":"The question"}],["$","p",null,{"children":"Underwater images contain more than objects to identify. They record patterns, relationships, and changes that need ecological context. My research asks how AI can connect visual observations with scientific evidence to support interpretation."}]]}],["$","section","The approach",{"children":[["$","h2",null,{"children":"The approach"}],["$","p",null,{"children":"I work across computer vision, ecological measurement, and retrieval from scientific literature. The aim is to develop workflows in which observations can be connected to evidence and used to formulate explanations that a researcher can inspect and test."}]]}],["$","section","The frontier",{"children":[["$","h2",null,{"children":"The frontier"}],["$","p",null,{"children":"Moving from recognition toward causal hypotheses also changes the evaluation problem. A plausible explanation is not necessarily a correct one. Evidence grounding, uncertainty, and the limits of the system are central research questions."}]]}],["$","section","Research context",{"children":[["$","h2",null,{"children":"Research context"}],["$","p",null,{"children":"This work is part of my M.Sc. research in Biotechnology at Bar-Ilan University’s Marine Ecosystem Dynamics Lab. It is ongoing research; causal diagnosis and ecological validity remain questions to be evaluated."}]]}]],["$","a",null,{"className":"text-link","href":"https://sites.biu.ac.il/en/marine-ecosystem-dynamics-lab","target":"_blank","rel":"noreferrer","children":["Marine Ecosystem Dynamics Lab",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M6 18 18 6M6 6h12v12","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","a",null,{"className":"text-link","href":"/work/ecological-intelligence/text","style":{"display":"flex","width":"fit-content","marginTop":20},"children":["Read as Markdown",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M6 18 18 6M6 6h12v12","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}],["$","section",null,{"className":"article-related","children":[["$","p",null,{"className":"eyebrow","children":"CONTINUE EXPLORING"}],["$","h2",null,{"style":{"marginTop":20},"children":"Nothing here stands alone."}],["$","div",null,{"children":[["$","a","marine-ai-