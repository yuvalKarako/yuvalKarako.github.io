d:T588,{"@context":"https://schema.org","@type":"Person","@id":"https://yuvalkarako.github.io/#person","name":"Yuval Karako","alternateName":"יובל קרקו","url":"https://yuvalkarako.github.io/","image":"https://yuvalkarako.github.io/media/portrait.webp","description":"Yuval Karako is a graduate researcher in AI & Biotechnology (M.Sc.) at Bar-Ilan University's Marine Ecosystem Dynamics Lab, where he leads an AI research project that moves from detecting ecological change to explaining its causes. He is the AI research lead on a 2026 BIU AI Convergence seed grant with Prof. Carmit Altman and Dr. Gal Eyal. He teaches agentic AI and personal knowledge bases to senior faculty in HIGH AI, Bar-Ilan's flagship AI program for academics, and leads digital transformation in the IDF Education & Youth Corps.","jobTitle":["Graduate Researcher in AI & Biotechnology, Bar-Ilan University","Head of Digital Transformation, IDF Education & Youth Corps","Teaching Faculty, HIGH AI"],"award":["BIU AI Convergence seed grant, 2026"],"affiliation":{"@type":"CollegeOrUniversity","name":"Bar-Ilan University","url":"https://www.biu.ac.il/en"},"sameAs":["https://www.linkedin.com/in/yuvalkarako/","https://github.com/yuvalKarako"],"knowsAbout":["Causal reasoning with AI","Retrieval-augmented generation","Computer vision for underwater imagery","Marine ecology","Agentic AI adoption","LLM knowledge bases","Product management"]}1:["$","main",null,{"id":"main","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],["$","section",null,{"className":"hero wrap","aria-labelledby":"hero-title","children":[["$","div",null,{"className":"hero-copy","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"status-dot"}]," YUVAL KARAKO · GRADUATE RESEARCHER IN AI & BIOTECHNOLOGY, BAR-ILAN UNIVERSITY"]}],["$","h1",null,{"id":"hero-title","children":["Building AI",["$","br",null,{"className":"desktop-break"}]," to understand",["$","br",null,{"className":"desktop-break"}]," ",["$","em",null,{"children":"complex systems."}]]}],false,false,false,false,false,false,["$","p",null,{"className":"hero-deck hero-deck-quiet","children":["My research at Bar-Ilan University asks how AI can explain what it observes, from ",["$","a",null,{"href":"/work/research#etiology-system","children":"automated monitoring of marine ecosystems"}]," to"," ",["$","a",null,{"href":"/work/research#coherence-to-meaning","children":"recovering structured meaning from low-coherence narratives"}],". Alongside it, I ",["$","a",null,{"href":"/work/teaching","children":"teach agentic AI to senior faculty"}]," and ",["$","a",null,{"href":"/work/public-service","children":"lead digital transformation in the IDF"}],"."]}],false,["$","div",null,{"className":"hero-actions","children":[["$","a",null,{"className":"button-primary","href":"#work","children":["See the work ",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","a",null,{"className":"text-link","href":"/","children":["The full profile ",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}],["$","div",null,{"className":"hero-graph","children":[["$","$Le",null,{"variant":"hero"}],["$","div",null,{"className":"graph-caption","children":[["$","span",null,{"className":"tiny-cross","children":"+"}]," HOW THE WORK CONNECTS",["$","a",null,{"href":"/map","aria-label":"Open the map","children":["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","pat