16:["$","section",null,{"className":"pattern-section","id":"perspective","aria-labelledby":"pattern-title","children":["$","div",null,{"className":"wrap pattern-grid","children":[["$","div",null,{"className":"pattern-mark","aria-hidden":"true","children":[["$","svg",null,{"viewBox":"0 0 240 240","children":[["$","path",null,{"d":"M32 120H208M120 32V208M58 58L182 182M58 182L182 58"}],["$","circle",null,{"cx":"120","cy":"120","r":"72"}],["$","circle",null,{"cx":"120","cy":"120","r":"105"}],["$","circle",null,{"className":"pattern-center","cx":"120","cy":"120","r":"7"}]]}],["$","span",null,{"className":"mono","children":"THE COMMON THREAD"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"02 — HOW I WORK"}],["$","h2",null,{"id":"pattern-title","children":["Knowledge is the asset,",["$","br",null,{}],["$","em",null,{"children":"not the model."}]]}],["$","p",null,{"className":"pattern-lead","children":"Every few months there is a better model. What does not get replaced is what a person or an organization already knows."}],["$","p",null,{"children":"Most of that knowledge sits in papers, files and people’s heads, where AI can’t use it and no one can check it. In each of my roles the work is the same: organize it so that AI can work with it, and so that a person can verify what comes out."}],["$","p",null,{"children":"In the lab, that means 845 scientific papers behind every diagnosis the system makes. In the classroom, it means a professor’s decades of research notes. In the IDF, it means turning scattered reports into data that commanders can rely on."}],["$","p",null,{"children":"One rule I hold myself to: measure what the AI gets wrong. In my thesis, the rate at which the system makes things up will be reported as a primary result, not a footnote."}]]}]]}]}]
