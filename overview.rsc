3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Building AI to understand complex systems — Yuval Karako"}],["$","meta","1",{"name":"description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology at Bar-Ilan University, leading an AI research project on automated monitoring of marine ecosystems. He designs and teaches agentic-AI practice for Bar-Ilan's senior academic leadership, and heads digital transformation in the IDF Education & Youth Corps."}],["$","meta","2",{"property":"og:title","content":"Yuval Karako — Graduate Researcher in AI & Biotechnology, Bar-Ilan University"}],["$","meta","3",{"property":"og:description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology at Bar-Ilan University, leading an AI research project on automated monitoring of marine ecosystems. He designs and teaches agentic-AI practice for Bar-Ilan's senior academic leadership, and heads digital transformation in the IDF Education & Youth Corps."}],["$","meta","4",{"property":"og:site_name","content":"Yuval Karako"}],["$","meta","5",{"property":"og:type","content":"website"}],["$","meta","6",{"property":"og:locale","content":"en_US"}],["$","meta","7",{"name":"twitter:card","content":"summary"}],["$","meta","8",{"name":"twitter:title","content":"Yuval Karako — Graduate Researcher in AI & Biotechnology, Bar-Ilan University"}],["$","meta","9",{"name":"twitter:description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology at Bar-Ilan University, leading an AI research project on automated monitoring of marine ecosystems. He designs and teaches agentic-AI practice for Bar-Ilan's senior academic leadership, and heads digital transformation in the IDF Education & Youth Corps."}],["$","link","10",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","11",{"rel":"c