10:[["$","div",null,{"className":"affiliation-strip","children":["$","div",null,{"className":"wrap affiliation-inner","children":[["$","span",null,{"className":"mono strip-label","children":"CURRENTLY"}],["$","a",null,{"href":"https://sites.biu.ac.il/en/marine-ecosystem-dynamics-lab","children":["Bar-Ilan University ",["$","span",null,{"children":"M.SC. RESEARCH"}]]}],["$","a",null,{"href":"/work/teaching","children":["HIGH AI ",["$","span",null,{"children":"TEACHING FACULTY"}]]}],["$","a",null,{"href":"/work/public-service","children":["IDF Education & Youth Corps ",["$","span",null,{"children":"DIGITAL TRANSFORMATION"}]]}],["$","a",null,{"href":"/work/research#coherence-to-meaning","children":["BIU AI Convergence ",["$","span",null,{"children":"SEED GRANT, 2026"}]]}]]}]}],["$","section",null,{"className":"section wrap","id":"work","aria-labelledby":"work-title","children":[["$","div",null,{"className":"section-top","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"01 — THE WORK"}],["$","h2",null,{"id":"work-title","children":["Research. Teaching.",["$","br",null,{}],["$","em",null,{"children":"Public service."}]]}]]}],["$","p",null,{"className":"section-intro","children":"Three roles that feed each other. The research produces the methods, the teaching puts them in front of senior experts, and the IDF tests them under real constraints."}]]}],[["$","article","research",{"className":"work-row","children":[["$","div",null,{"className":"work-index","children":[["$","span",null,{"className":"mono","children":["0",1]}],["$","span",null,{"className":"eyebrow","children":"RESEARCH"}]]}],["$","div",null,{"className":"work-copy","children":[["$","h3",null,{"children":["$","a",null,{"href":"/work/research","children":"AI that explains why a reef is changing."}]}],["$","p",null,{"children":"My M.Sc. thesis builds an AI system that goes past labeling underwater images. It measures each coral, follows it over time, and when it finds damage, proposes likely causes based on 845 scientific papers. Most existing tools stop at the labeling step. Around it: a BIU AI Convergence grant with Prof. Carmit Altman, a systematic review, and a collaboration with the Technion."}],["$","div",null,{"className":"work-meta mono","children":"M.Sc. Biotechnology · Marine Ecosystem Dynamics Lab (Dr. Gal Eyal) · Bar-Ilan University"}]]}],["$","a",null,{"className":"work-go","href":"/work/research","aria-label":"Explore Research","children":[["$","span",null,{"children":"The research"}],["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}],["$","article","teaching",{"className":"work-row","children":[["$","div",null,{"className":"work-index","children":[["$","span",null,{"className":"mono","children":["0",2]}],["$","span",null,{"className":"eyebrow","children":"TEACHING"}]]}],["$","div",null,{"className":"work-copy","children":[["$","h3",null,{"children":["$","a",null,{"href":"/work/teaching","children":"Teaching Bar-Ilan’s senior faculty to work with AI."}]}],["$","p",null,{"children":"I’m on the teaching faculty of HIGH AI, Bar-Ilan University’s flagship program for training senior academics in agentic AI. I teach its unit on building a personal knowledge base to deans, department heads and research-institute directors."}],["$","div",null,{"className":"work-meta mono","children":"Teaching faculty · HIGH AI · Bar-Ilan University"}]]}],["$","a",null,{"className":"work-go","href":"/work/teaching","aria-label":"Explore Teaching agentic AI","children":[["$","span",null,{"children":"The method"}],["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWi